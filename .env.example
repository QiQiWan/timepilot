TIMEPILOT_HOME=./runtime   # optional: defaults to ~/.timepilot
TIMEPILOT_DB_URL=
TIMEPILOT_HOST=127.0.0.1
TIMEPILOT_PORT=8000
TIMEPILOT_LOCAL_MODE=1
TIMEPILOT_ALLOWED_ORIGIN=http://localhost:5173
TIMEPILOT_MAX_UPLOAD_MB=25
TIMEPILOT_WORKER_POLL_SECONDS=2
TIMEPILOT_LEASE_SECONDS=120
TIMEPILOT_DEFAULT_BUDGET_SECONDS=180
TIMEPILOT_MIN_FREE_GB=0.5
# Configure the model service in Web Settings; credentials are stored in the local work directory.
# Never expose the local development server to public networks.

# Optional BI database snapshot connector; account must have SELECT-only privileges.
# Both fields are required for any database table to appear in the BI workspace.
TIMEPILOT_BI_SOURCE_URL=
TIMEPILOT_BI_ALLOWED_TABLES=

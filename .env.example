# Optional: leave unset to use ~/.timepilot for a new installation.
# An existing source/runtime folder stays in use for backwards compatibility.
# TIMEPILOT_HOME=/absolute/local/path/to/timepilot-data
TIMEPILOT_DB_URL=
TIMEPILOT_HOST=127.0.0.1
TIMEPILOT_PORT=8000
TIMEPILOT_LOCAL_MODE=1
TIMEPILOT_ALLOWED_ORIGIN=http://localhost:5173
TIMEPILOT_MAX_UPLOAD_MB=25
TIMEPILOT_WORKER_POLL_SECONDS=2
TIMEPILOT_LEASE_SECONDS=120
TIMEPILOT_DEFAULT_BUDGET_SECONDS=180
TIMEPILOT_MIN_FREE_GB=0.5
# Configure the model service in Web Settings; credentials are stored in the local work directory.
# Never expose the local development server to public networks.

# Optional BI database snapshot connector; account must have SELECT-only privileges.
# Both fields are required for any database table to appear in the BI workspace.
TIMEPILOT_BI_SOURCE_URL=
TIMEPILOT_BI_ALLOWED_TABLES=

# v0.21.0 enterprise auth: opt-in. Keep local mode enabled for a single-user
# research installation. For enterprise mode, use TLS at a trusted reverse
# proxy, local private storage and offline administrator provisioning.
# TIMEPILOT_ENTERPRISE_MODE=1
# TIMEPILOT_LOCAL_MODE=0
# TIMEPILOT_PUBLIC_BASE_URL=https://timepilot.internal.example
# TIMEPILOT_HOST=127.0.0.1
# TIMEPILOT_HOME=/private/local/timepilot/runtime

# Production acceptance work sizes, executed only on explicit request.
# TIMEPILOT_PRODUCTION_RECOVERY_ROWS=1000000
# TIMEPILOT_BENCH_SMALL_ROWS=100000
# TIMEPILOT_BENCH_MID_ROWS=1000000
# TIMEPILOT_BENCH_LARGE_ROWS=10000000

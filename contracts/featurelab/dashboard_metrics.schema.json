{
  "$defs": {
    "DashboardMetricScope": {
      "additionalProperties": false,
      "properties": {
        "field_ids": {
          "items": {
            "type": "string"
          },
          "title": "Field Ids",
          "type": "array"
        },
        "rows": {
          "minimum": 0,
          "title": "Rows",
          "type": "integer"
        },
        "denominator_cells": {
          "minimum": 0,
          "title": "Denominator Cells",
          "type": "integer"
        },
        "population": {
          "const": "filtered_version_rows",
          "default": "filtered_version_rows",
          "title": "Population",
          "type": "string"
        },
        "missing_policy": {
          "const": "sql_null_plus_non_finite_plus_conversion_failed",
          "default": "sql_null_plus_non_finite_plus_conversion_failed",
          "title": "Missing Policy",
          "type": "string"
        },
        "field_limit": {
          "minimum": 1,
          "title": "Field Limit",
          "type": "integer"
        }
      },
      "required": [
        "field_ids",
        "rows",
        "denominator_cells",
        "field_limit"
      ],
      "title": "DashboardMetricScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "records": {
      "minimum": 0,
      "title": "Records",
      "type": "integer"
    },
    "source_records": {
      "minimum": 0,
      "title": "Source Records",
      "type": "integer"
    },
    "columns": {
      "minimum": 0,
      "title": "Columns",
      "type": "integer"
    },
    "numeric_fields": {
      "minimum": 0,
      "title": "Numeric Fields",
      "type": "integer"
    },
    "selected_fields": {
      "minimum": 0,
      "title": "Selected Fields",
      "type": "integer"
    },
    "missing_cells": {
      "minimum": 0,
      "title": "Missing Cells",
      "type": "integer"
    },
    "invalid_numeric_cells": {
      "minimum": 0,
      "title": "Invalid Numeric Cells",
      "type": "integer"
    },
    "non_finite_numeric_cells": {
      "minimum": 0,
      "title": "Non Finite Numeric Cells",
      "type": "integer"
    },
    "conversion_failed_cells": {
      "minimum": 0,
      "title": "Conversion Failed Cells",
      "type": "integer"
    },
    "missing_percent": {
